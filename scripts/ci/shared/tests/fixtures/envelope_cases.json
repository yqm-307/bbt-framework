        "artifact_path": "out/manifest.json"
      },
      "expected": "expected",
      "expect": "reject",
      "code": "E_ENV_REBOUND"
    },
    {
      "name": "rerun_wrong_source",
      "producer": "valid_envelope",
      "rerun": {
        "producer_repo": "yqm-307/bbt-framework",
        "producer_source_sha": "0000000000000000000000000000000000000000",
        "producer_run_id": 123456,
        "producer_run_attempt": 1,
        "workflow_sha": "fedcba9876543210fedcba9876543210fedcba98",
        "job": "verify",
        "artifact_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "artifact_path": "out/manifest.json"
      },
      "expected": "expected",
      "expect": "reject",
      "code": "E_ENV_IDENTITY_MISMATCH"
    },
    {
      "name": "rerun_path_escape",
      "producer": "valid_envelope",
      "rerun": {
        "producer_repo": "yqm-307/bbt-framework",
        "producer_source_sha": "a60edfb4f7cd77e69926be475e2c45e324a3db2b",
        "producer_run_id": 123456,
        "producer_run_attempt": 1,
        "workflow_sha": "fedcba9876543210fedcba9876543210fedcba98",
        "job": "verify",
