{
  "_comment": "typed 输入契约正反 fixtures；每个用例经 coerce_workflow_inputs（同时覆盖字符串/typed 两种传入）。",
  "cases": [
    {
      "name": "valid_typed",
      "expect": "ok",
      "payload": {
        "repo": "yqm-307/bbt-framework",
        "source_sha": "a60edfb4f7cd77e69926be475e2c45e324a3db2b",
        "profile": "hosted",
        "concurrency": 2,
        "timeout_minutes": 20,
        "event": {"name": "pull_request", "base_ref": "main"},
        "changed_files": ["framework/app.cpp"],
        "required_checks": ["lint", "unit"],
        "optional_checks": ["heavy", "perf"],
        "classifier_status": "ok"
      }
    },
    {
      "name": "valid_coerced_strings",
      "expect": "ok",
      "payload": {
        "repo": "yqm-307/bbt-framework",
        "source_sha": "a60edfb4f7cd77e69926be475e2c45e324a3db2b",
        "profile": "hosted",
        "concurrency": "2",
        "timeout_minutes": "20",
        "event": {"name": "push", "head_ref": "main"},
        "changed_files_json": "[\"docs/ci/api.md\"]",
        "required_checks_json": "[\"lint\"]",
        "optional_checks_json": "[\"heavy\"]",
        "classifier_status": "ok"
      }
    },
    {
      "name": "short_sha",
